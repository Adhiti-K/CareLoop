PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email configuration for appointment and discharge alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=careloop.system@gmail.com
EMAIL_PASSWORD=your-email-app-password

# Base URL encoded inside Patient QR Passport
QR_BASE_URL=http://localhost:5173/verify-passport
